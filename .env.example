# ---------------------------------------------------------------------------
# Quiz Bank — environment variables
# Copy this file to `.env` and fill in the values.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (required).
# Local Docker default used by this project:
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# --- AI grading agent -------------------------------------------------------
# Which grading provider to use for written answers: mock | openai | anthropic
# "mock" is a deterministic offline grader — no key needed, great for dev/demo.
AI_PROVIDER=mock

# OpenAI (only when AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: OpenAI-compatible gateway (e.g. Z.ai: https://api.z.ai/api/paas/v4)
OPENAI_BASE_URL=

# Anthropic (only when AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# --- Seed admin account ------------------------------------------------------
# Used by `npm run seed` to create the initial admin user.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin123456

# --- Supabase (optional) -----------------------------------------------------
# The live app runs on Drizzle + the DATABASE_URL above. If you deploy on
# Supabase instead, run supabase/schema.sql in the SQL editor and point
# DATABASE_URL at the Supabase pooled connection string:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
